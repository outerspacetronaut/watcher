# One watcher instance per project: `systemctl enable --now watcher@<name>`.
# /etc/watcher/env holds optional notification webhooks and legacy Claude token settings.
# GPT lanes use Codex's saved ChatGPT sign-in as watcher, not a token in this file.
# Select the Codex adapter and zero legacy CLI caps in projects/<name>.env; docs/codex.md.
# Legacy Claude lanes must not set ANTHROPIC_API_KEY here (separately billed API login).
[Unit]
Description=Board watcher for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=watcher
Group=watcher
WorkingDirectory=/opt/watcher
EnvironmentFile=/etc/watcher/env
Environment=WATCHER_PROJECT=/opt/watcher/projects/%i.env
Environment=HOME=/home/watcher
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/watcher/bin/spawn.sh
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
